[Unit]
Description=FiveM FXServer & txAdmin Service
After=network.target network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=simple
User=fivem
Group=fivem
WorkingDirectory=/opt/fivem/server
Environment=TXHOST_DATA_PATH=/opt/fivem/txData
ExecStart=/opt/fivem/server/run.sh
Restart=on-failure
RestartSec=10
LimitNOFILE=65535
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
