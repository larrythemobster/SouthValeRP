## Example Secrets File for SouthVale RP
## Copy this file to secrets.cfg on your server host:
## cp secrets.cfg.example secrets.cfg
## chmod 600 secrets.cfg
##
## DO NOT COMMIT REAL CREDENTIALS TO GIT!

## Database Connection String
set mysql_connection_string "mysql://qbox:YOUR_STRONG_PASSWORD@127.0.0.1/qbox?charset=utf8mb4"

## Cfx.re Server License Key (https://keymaster.fivem.net/)
sv_licenseKey "cfxk_YOUR_KEYMASTER_LICENSE_KEY_HERE"

## Optional Steam Web API Key (https://steamcommunity.com/dev/apikey)
# set steam_webApiKey "YOUR_STEAM_WEB_API_KEY"

## Optional Discord Webhooks / Tokens
# set discord_webhook "YOUR_DISCORD_WEBHOOK_URL"
